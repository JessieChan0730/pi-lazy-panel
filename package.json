{
	"name": "pi-lazy-panel",
	"version": "0.1.3",
	"description": "A lazygit-style TUI for browsing, resuming and managing pi sessions (/lazy-panel)",
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package",
		"lazygit",
		"sessions",
		"tui"
	],
	"homepage": "https://github.com/JessieChan0730/pi-lazy-panel#readme",
	"bugs": {
		"url": "https://github.com/JessieChan0730/pi-lazy-panel/issues"
	},
	"license": "MIT",
	"author": "JessieChan0730",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JessieChan0730/pi-lazy-panel.git"
	},
	"files": [
		"index.ts",
		"src",
		"docs/design.md",
		"docs/keybindings.md",
		"docs/keybindings.zh.md",
		"README.md"
	],
	"type": "module",
	"scripts": {
		"check": "tsc --noEmit",
		"test": "node --import tsx --test \"test/**/*.test.ts\"",
		"dev": "pi -e ./index.ts",
		"install:pi": "pi install .",
		"uninstall:pi": "pi remove .",
		"i18n:scan": "node scripts/i18n-scan.mjs",
		"i18n:check": "node scripts/i18n-scan.mjs --check",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"ci": "node scripts/ci-check.mjs",
		"prepare": "node scripts/install-hooks.mjs"
	},
	"dependencies": {
		"i18next": "23.16.8"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^22.14.0",
		"eslint": "^10.11.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"tsx": "^4.19.0",
		"typebox": "1.3.7",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.70.1"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=20"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"image": "https://raw.githubusercontent.com/JessieChan0730/pi-lazy-panel/HEAD/assets/readme/preview-en.png"
	}
}
