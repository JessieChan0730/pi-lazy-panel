{
	"name": "pi-lazy-panel",
	"version": "0.1.0",
	"description": "A lazygit-style TUI for browsing, resuming and managing pi sessions (/lazy-panel)",
	"type": "module",
	"private": true,
	"keywords": [
		"pi-package",
		"pi",
		"tui",
		"sessions",
		"lazygit"
	],
	"license": "MIT",
	"files": [
		"src",
		"docs",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "node --import tsx --test \"test/**/*.test.ts\"",
		"dev": "pi -e ./src/index.ts",
		"install:pi": "pi install .",
		"uninstall:pi": "pi remove .",
		"i18n:scan": "node scripts/i18n-scan.mjs",
		"i18n:check": "node scripts/i18n-scan.mjs --check",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"ci": "node scripts/ci-check.mjs",
		"prepare": "node scripts/install-hooks.mjs"
	},
	"dependencies": {
		"i18next": "23.16.8"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^22.14.0",
		"eslint": "^10.11.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"tsx": "^4.19.0",
		"typebox": "1.3.7",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.70.1"
	},
	"engines": {
		"node": ">=20"
	}
}
