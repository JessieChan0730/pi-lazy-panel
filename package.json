{
	"name": "pi-lazy-panel",
	"version": "0.1.0",
	"description": "A lazygit-style TUI for browsing, resuming and managing pi sessions (/lazy-history)",
	"type": "module",
	"private": true,
	"keywords": [
		"pi-package",
		"pi",
		"tui",
		"sessions",
		"lazygit"
	],
	"license": "MIT",
	"files": [
		"src",
		"docs",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "node --import tsx --test \"test/**/*.test.ts\"",
		"dev": "pi -e ./src/index.ts",
		"install:pi": "pi install .",
		"uninstall:pi": "pi remove ."
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@types/node": "^22.14.0",
		"tsx": "^4.19.0",
		"typebox": "1.3.7",
		"typescript": "^5.6.0"
	},
	"engines": {
		"node": ">=20"
	}
}
